#!/usr/bin/env python3
"""
Tkinter Weather App (single-file, Python 3.10)

Features:
- Manual location input (city name or "lat,lon")
- Automatic location detection via IP geolocation
- Detailed weather from Open-Meteo (no API key)
- Current weather, hourly (12h) and daily (7d) forecasts
- Wind speed, humidity, sunrise/sunset
- Small temperature line chart using Tkinter Canvas
- Uses only: requests (pip install requests)

Run:
    python weather_app.py
"""

import tkinter as tk
from tkinter import ttk, messagebox
import requests
import threading
import math
from datetime import datetime, timedelta, timezone

# ----------------------------
# Configurable constants
# ----------------------------
IP_GEO_URL = "http://ip-api.com/json/"  # returns JSON with lat/lon
OPEN_METEO_BASE = "https://api.open-meteo.com/v1/forecast"
DEFAULT_LANG = "en"
DEFAULT_UNITS = "metric"  # 'metric' or 'imperial' (we convert wind if imperial)
HOUR_COUNT = 12  # how many hours in hourly view
DAY_COUNT = 7    # how many days in daily view

# ----------------------------
# Weathercode (WMO) -> emoji + description
# Source: Open-Meteo uses WMO weather codes
# ----------------------------
WMO_MAP = {
    0: ("☀️", "Clear sky"),
    1: ("🌤️", "Mainly clear"),
    2: ("⛅", "Partly cloudy"),
    3: ("☁️", "Overcast"),
    45: ("🌫️", "Fog"),
    48: ("🌫️", "Depositing rime fog"),
    51: ("🌦️", "Light drizzle"),
    53: ("🌦️", "Moderate drizzle"),
    55: ("🌧️", "Dense drizzle"),
    56: ("🌧️", "Freezing drizzle"),
    57: ("🌧️", "Dense freezing drizzle"),
    61: ("🌧️", "Slight rain"),
    63: ("🌧️", "Moderate rain"),
    65: ("🌧️", "Heavy rain"),
    66: ("🌧️", "Freezing rain"),
    67: ("🌧️", "Heavy freezing rain"),
    71: ("🌨️", "Slight snow fall"),
    73: ("🌨️", "Moderate snow fall"),
    75: ("🌨️", "Heavy snow fall"),
    77: ("🌨️", "Snow grains"),
    80: ("🌦️", "Slight rain showers"),
    81: ("🌧️", "Moderate rain showers"),
